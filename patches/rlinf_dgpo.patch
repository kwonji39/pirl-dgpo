index 00000000..bab1fb11
--- /dev/null
+++ b/examples/embodiment/config/calvin_abc_d_dgpo_openpi_pi05.yaml
@@ -0,0 +1,165 @@
+defaults:
+  - env/calvin_abc@env.train
+  - env/calvin_d@env.eval
+  - model/pi0_5@actor.model
+  - hybrid_engines/fsdp@actor.fsdp_config
+  - weight_syncer/patch_syncer@weight_syncer
+  - override hydra/job_logging: stdout
+
+hydra:
+  run:
+    dir: .
+  output_subdir: null
+  searchpath:
+    - file://${oc.env:EMBODIED_PATH}/config/
+
+cluster:
+  num_nodes: 1
+  component_placement:
+    actor,env,rollout: all
+
+runner:
+  task_type: embodied
+  logger:
+    log_path: "../results"
+    project_name: rlinf
+    experiment_name: "calvin_abc_d_dgpo_openpi_pi05"
+    logger_backends: ["tensorboard"] # wandb, swanlab
+
+  max_epochs: 1000
+  max_steps: -1
+
+  only_eval: False
+  val_check_interval: -1
+  save_interval: 10
+
+  resume_dir: null # Optional: path to a saved checkpoint directory, such as 'checkpoints/global_step_10'. If not None, it will be used to resume training.
+  ckpt_path: null  # Optional: path to a .pt checkpoint. If not None, it will be loaded after the model is instantiated (for evaluation).
+
+algorithm:
+  normalize_advantages: True
+  kl_penalty: kl  # how to estimate kl divergence: kl or kl_penalty
+  group_size: 8
+  reward_coef: 1.0
+
+  reward_type: chunk_level
+  logprob_type: chunk_level
+  entropy_type: token_level
+
+  update_epoch: 2          # best DGPO setting on LIBERO-Spatial
+  adv_type: grpo
+  loss_type: embodied_dgpo
+  loss_agg_func: "token-mean" 
+  kl_beta: 0.0
+  entropy_bonus: 0
+  clip_ratio_high: 0.2
+  clip_ratio_low: 0.2
+  clip_ratio_c: 3.0
+  value_clip: 0.2
+  huber_delta: 10.0
+
+  gamma: 0.99
+  gae_lambda: 0.95
+
+  filter_rewards: True
+  rewards_lower_bound: 0.1
+  rewards_upper_bound: 0.9
+
+  # DGPO (arXiv:2510.08425). Math: rlinf/algorithms/dgpo.py
+  dgpo_beta: 10000.0            # paper uses 100; here z ~ 1e-2 so 100 left the gate at 0.5 (run 54407201)
+  dgpo_t_min: 0.3               # timestep clip: t ~ U[t_min, t_max], t=1 is noise (pi0 convention)
+  dgpo_t_max: 1.0
+  dgpo_share_t_in_group: True   # one t per group, as the official code shares t across the batch
+  dgpo_traj_reduction: mean     # sum collapsed run 54407201: failures run 48 chunks, successes stop early, so sum(A_i*n_i) < 0
+  dgpo_adv_clip: 5.0
+  dgpo_kl_beta: 0.0             # optional velocity-space KL to the reference
+  dgpo_num_minibatches: 1       # optimizer steps per pass; each is group-aligned and exact
+  dgpo_loss_dims: executed      # executed = [:action_chunk, :action_env_dim], as piRL's log-probs
+  dgpo_ref_offload: True        # frozen SFT reference lives on CPU between uses
+  dgpo_loss_scale: 100.0        # constant; keeps grads well above Adam eps (smoke 54402772: norm ~5e-3 at 1.0)
+  nft_tau: 1.0                  # rollout policy theta^-: 1.0 = on-policy. Paper: [1.0, 0.7, 200, 200]
+env:
+  group_name: "EnvGroup"
+
+  train:
+    auto_reset: False            # DGPO needs per-trajectory masks
+    ignore_terminations: False
+    group_size: ${algorithm.group_size}
+    rollout_epoch: 8
+    total_num_envs: 64
+    max_episode_steps: 480 # for truncation
+    max_steps_per_rollout_epoch: 480
+    reward_coef: ${algorithm.reward_coef}
+    video_cfg:
+      save_video: True
+      video_base_dir: ${runner.logger.log_path}/video/train
+  eval:
+    rollout_epoch: 1
+    total_num_envs: 50
+    auto_reset: True
+    ignore_terminations: True
+    max_episode_steps: 480
+    max_steps_per_rollout_epoch: 9600
+    use_fixed_reset_state_ids: True
+    use_ordered_reset_state_ids: True
+    is_eval: True
+    video_cfg:
+      save_video: True
+      video_base_dir: ${runner.logger.log_path}/video/eval
+
+rollout:
+  group_name: "RolloutGroup"
+  generation_backend: "huggingface"
+  recompute_logprobs: False
+  enable_offload: False
+  pipeline_stage_num: 1
+
+  model:
+    model_path: "/path/to/model/RLinf-Pi05-CALVIN-ABC-D-SFT" # https://huggingface.co/RLinf/RLinf-Pi05-CALVIN-ABC-D-SFT
+    precision: ${actor.model.precision}
+
+actor:
+  group_name: "ActorGroup"
+  training_backend: "fsdp"
+
+  micro_batch_size: 128
+  global_batch_size: 2048 # maximum : global batch size = micro batch size * actor num_processes.
+  seed: 42
+  enable_offload: False
+
+  model:
+    model_path: "/path/to/model/RLinf-Pi05-CALVIN-ABC-D-SFT" # https://huggingface.co/RLinf/RLinf-Pi05-CALVIN-ABC-D-SFT
+    model_type: "openpi"
+    num_action_chunks: 5
+    add_value_head: False
+    # openpi specific parameters
+    openpi:
+      is_nft: True             # stores the clean chunk nft_x0 that DGPO trains on
+      noise_method: "flow_sde"   # DGPO w/ SDE: ODE rollouts gave no signal on LIBERO
+      noise_level: 0.3           # 0.5/sqrt(3): noise on all 3-4 steps ~ piRL's one step at 0.5
+      joint_logprob: False
+      config_name: "pi05_calvin"
+      num_images_in_input: 2
+      value_after_vlm: True
+      value_vlm_mode: "mean_token"
+
+  optim:
+    lr: 5.0e-6
+    value_lr: 1.0e-4
+    adam_beta1: 0.9
+    adam_beta2: 0.95
+    adam_eps: 1.0e-08
+    clip_grad: 1.0
+    weight_decay: 0.01
+    critic_warmup_steps: 0
+
+  fsdp_config:
+    strategy: "fsdp"
+    sharding_strategy: "no_shard"
+    gradient_checkpointing: False # for openpi, gradient checkpointing is not supported, please do not change this value
+
+reward:
+  use_reward_model: False
+
+critic:
+  use_critic_model: False
